# Environment Variables — OMNI HUB
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# ─────────────────────────────────────────────
# GEMINI AI
# ─────────────────────────────────────────────

# Your Google Gemini API key (server-side only — never expose to clients)
GEMINI_API_KEY=

# Generation model used for all AI actions (summarize, ask, explain, etc.)
GEMINI_MODEL=gemini-3.8-flash

# Embedding model — produces vectors for semantic memory
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Output dimensionality for embeddings (128–3072, MRL-supported).
# Recommended: 768 | 1536 | 3072  |  MVP default: 1536
# WARNING: All stored chunks must share the same dimension.
#          Changing this after data is saved requires re-embedding + ALTER TABLE.
EMBEDDING_DIMENSIONS=1536

# ─────────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────────

# Your Supabase project URL (safe to expose to clients)
SUPABASE_URL=

# Supabase anonymous/public key (safe to expose to clients; RLS enforced)
SUPABASE_ANON_KEY=

# Supabase service role key — BACKEND ONLY. Grants full DB access. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────

# FastAPI backend base URL (used by extension and web app to reach the API)
BACKEND_URL=http://localhost:8000

# Vite-prefixed version for client-side builds (extension + web)
VITE_API_URL=http://localhost:8000

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Application environment
APP_ENV=development
